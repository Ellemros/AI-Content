# Copy to .env. Leave provider keys empty to run fully offline.

APP_NAME=AI Content Factory
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/app.db
DATA_DIR=./data

# Paid providers. Empty means the local fallback is used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_INPUT_COST_PER_MILLION=0.15
OPENAI_OUTPUT_COST_PER_MILLION=0.60
OPENAI_MAX_OUTPUT_TOKENS=2500

ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
ELEVENLABS_VOICE_ID_EN=
ELEVENLABS_VOICE_ID_CS=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_COST_PER_1K_CHARS=0.30

# auto: ElevenLabs if a key is set, otherwise Edge TTS, otherwise espeak-ng.
# Use espeak for a fully offline render with no network.
TTS_PROVIDER=auto
EDGE_VOICE_EN=en-US-AriaNeural
EDGE_VOICE_CS=cs-CZ-VlastaNeural
ESPEAK_BIN=espeak-ng
ESPEAK_VOICE_EN=en-us
ESPEAK_VOICE_CS=cs

# Paid calls that would exceed this cap fail with a clear error. 0 blocks all paid calls.
MONTHLY_SPEND_CAP_USD=25
PROVIDER_RETRIES=3
PROVIDER_RETRY_BASE_SECONDS=0.5

NEAR_DUPLICATE_THRESHOLD=0.82
FONT_PATH=

# Scheduler. On a new database this seeds the Production page switch.
# After that, the switch in the dashboard is what the poller reads.
# Topic schedules stop before approval and never export or upload.
# The same poller runs active brands. It does not start a second worker.
SCHEDULER_ENABLED=false
SCHEDULER_POLL_SECONDS=30

# Brand automation emergency switch. On a new database this seeds the Production page.
# false means no brand produces until you turn it on. 0 poll seconds keeps the worker off.
AUTOMATION_ENABLED=false

# Content intelligence. Scores are heuristics, not search volume.
# EDITORIAL_GATE=true refuses a render below the quality minimum. Leave it false to keep render-short unchanged.
TOPIC_SCORE_MINIMUM=55
EDITORIAL_QUALITY_MINIMUM=70
EDITORIAL_GATE=false
RESEARCH_TIMEOUT_SECONDS=8
RESEARCH_MAX_ITEMS=8
RESEARCH_VERIFY_LIMIT=8

# Brand opportunity cycle. 0 disables the background poll. The CLI still runs one cycle.
BRAND_CYCLE_POLL_SECONDS=0
# Optional. A public YouTube search sample. It is not a demand score and it does not upload.
YOUTUBE_API_KEY=
OPPORTUNITY_WEIGHT_MONETIZATION=0.25
OPPORTUNITY_WEIGHT_DEMAND=0.20
OPPORTUNITY_WEIGHT_COMPETITION=0.15
OPPORTUNITY_WEIGHT_SCALABILITY=0.15
OPPORTUNITY_WEIGHT_AFFILIATE=0.10
OPPORTUNITY_WEIGHT_COST=0.10
OPPORTUNITY_WEIGHT_EVERGREEN=0.05

# Local video production. These caps apply to paid calls. Local steps cost 0.
PRODUCTION_VIDEO_CAP_USD=1
PRODUCTION_DAILY_CAP_USD=5
# none or wikimedia. Wikimedia stills are used only with an allowed Commons license.
PRODUCTION_STOCK=none
